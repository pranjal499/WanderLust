<style>
  .search-btn {
    background-color: #fe424d;
    color: #fff;
    border: none;
    border-radius: 25px;
    padding: 0 1rem;
  }
  .search-btn:hover {
    background-color: #cf2b36;
    color: #fff;
  }

  .search-btn i {
    display: inline;
    margin-right: 0.5rem;
  }

  /* Search input  */
  .search-inp {
    border-radius: 25px;
    padding: 0.5rem 3rem;
    font-size: 0.8rem;
  }
</style>

<!-- Navigation Bar -->
<nav class="navbar navbar-expand-md bg-body-light border-bottom sticky-top">

  <!-- Container for navbar content -->
  <div class="container-fluid">

    <!-- Brand logo and name -->
    <a class="navbar-brand" href="/listings">
      <i class="fa-solid fa-compass"></i> WanderLust
    </a>

    <!-- Toggler button for collapsing navbar on smaller screens -->
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav">
        <a class="nav-link" href="/listings">Explore</a>
      </div>

      <!-- Search element: -->
      <div class="navbar-nav ms-auto">
        <div class="container-fluid">
          <form class="d-flex" role="search">
            <input class="form-control me-2 search-inp" type="search" placeholder="Search Destinations" aria-label="Search" />
            <button class="btn btn-outline-success search-btn" type="submit"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
          </form>
        </div>
      </div>

      <div class="navbar-nav ms-auto">
        <a class="nav-link" href="/listings/new">Add Listings</a>
        <% if(!currUser) { %>
          <!-- Login link -->
          <a class="nav-link" aria-current="page" href="/login"><b>Login</b></a>

          <!-- Sign up page link -->
          <a class="nav-link" href="/signup"><b>Signup</b></a>
          <% } %>

            <% if (currUser) { %>
              <a class="nav-link" href="#"><i>
                  <%= currUser.username %>
                </i></a>

              <!-- Logout link -->
              <a class="nav-link" href="/logout"><b>Logout</b></a>
              <% } %>
      </div>
    </div>
  </div>

  </div>
</nav>