<%- layout('/layouts/boilarplate.ejs') %>

    <body>
        <div class="row listing-form">
            <div class="col-8 offset-2">
                <h3>Edit <%= item.title %>
                </h3>
                <form action="/listings/<%= item._id%>?_method=put" method="post" class="needs-validation" novalidate enctype="multipart/form-data">

                    <!-- Title -->
                    <div class="mb-3">
                        <label for="title" class="form-lable">Title:</label>
                        <input type="text" name="listing[title]" placeholder="Enter title" class="form-control"
                            value="<%= item.title %>" required>
                            <div class="valid-feedback">Look's good</div>
                    </div>

                    <!-- Description -->
                    <div class="mb-3">
                        <label for="description" class="form-lable">Description:</label>
                        <textarea placeholder="Enter title" name="listing[description]"
                            class="form-control" required><%= item.description %></textarea>
                            <div class="invalid-feedback">Please write a short description</div>
                    </div>

                    <!-- Image -->
                    <div class="mb-3">
                        <label for="image" class="form-lable">Upload Listing Image:</label>
                        <input type="file" name="listing[image]" class="form-control">
                    </div>

                    <div class="row">
                        <!-- Price -->
                        <div class="mb-3 col-md-4">
                            <label for="price" class="form-lable">Price:</label>
                            <input type="number" name="listing[price]" placeholder="Enter price" class="form-control"
                                value="<%= item.price %>" required>
                            <div class="invalid-feedback">Please set a price</div>
                        </div>

                        <!-- Country -->
                        <div class="mb-3 col-md-8">
                            <label for="country" class="form-lable">Country:</label>
                            <input type="text" name="listing[country]" placeholder="Country" class="form-control"
                                value="<%= item.country %>" required>
                            <div class="invalid-feedback">Please enter a country</div>
                        </div>
                    </div>

                    <!-- Location -->
                    <div class="mb-3">
                        <label for="location" class="form-lable">Location:</label>
                        <input type="text" name="listing[location]" placeholder="Enter location" class="form-control"
                            value="<%= item.location %>" required>
                        <div class="invalid-feedback">Please add a location</div>
                    </div>

                    <!-- Button -->
                    <button class="btn btn-dark btn-add">Update</button>
                </form>
            </div>
        </div>
    </body>