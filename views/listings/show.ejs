<% layout('/layouts/boilarplate.ejs') %>

    <!-- Body -->

    <body>

        <!-- Listing card -->
        <div class="row listing-form">
            <div class="col-6 offset-3">

                <div class="card listing-card" style="width: 30rem;">
                    <h3>
                        <%= item.title%>
                    </h3>
                    <img src="<%= item.image.url %>" class="card-img-top" alt="<%= item.title%>">

                    <div class="card-body">
                        <ul>
                            <b>
                                <%= item.title%>
                            </b>
                            <li style="list-style: none;">
                                <i>Owned by - <%= item.owner.username %></i>
                            </li>
                            <li>
                                <%= item.description%>
                            </li>
                            <li>&#8377;<%= item.price.toLocaleString("en-in")%>
                            </li>
                            <li>
                                <%= item.location%>
                            </li>
                        </ul>
                        <br>
                        <!-- Buttons -->
                        <% if (currUser && currUser._id.toString()===item.owner._id.toString()) { %>
                            <div class="show-btns">
                                <a href="/listings/<%= item._id%>/edit" class="btn btn-dark btn-add">Edit</a>
                                <form action="/listings/<%= item._id%>?_method=delete" method="post">
                                    <button class="btn btn-dark">Delete</button>
                                </form>
                            </div>
                            <% } %>

                    </div>
                </div>
            </div>

            <!-- Review -->

            <div class="col-6 offset-3">
                <% if(currUser) { %>
                    <hr>
                    <h4>Leave a review</h4>

                    <form action="/listings/<%= item.id%>/reviews" method="post" novalidate class="needs-validation">
                        <label for="rating" class="form-lable">Rating</label>
                        <div class="mb-3 mt-3">

                            <fieldset class="starability-basic">
                            

                            <!-- <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range">
                            <div class="mb-3 mt-3"> -->
                                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked
                                    aria-label="No rating." />
                                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                <label for="first-rate1" title="Terrible">1 star</label>
                                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                <label for="first-rate2" title="Not good">2 stars</label>
                                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                <label for="first-rate3" title="Average">3 stars</label>
                                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                <label for="first-rate4" title="Very good">4 stars</label>
                                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                <label for="first-rate5" title="Amazing">5 stars</label>
                            </fieldset>

                            <label for="comment" class="form-lable">Comment</label>

                            <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"
                                required></textarea>

                            <div class="invalid-feedback">Please write a comment</div>

                        </div>

                        <button class="btn btn-outline-dark">Submit</button>
                    </form>
                    <% } %>

                        <hr>
                        <h4>Reviews</h4>

                        <div class="row">

                            <% for (review of item.reviews) { %>
                                <div class="card col-5 mb-3 ms-3">
                                    <div class="card-body">
                                        <h5 class="card-title">@<%= review.auther.username %>
                                        </h5>
                                        <p class="starability-result card-text" data-rating="<%= review.rating %>">
                                        </p>
                                        <p class="card-text">
                                            <%= review.comment %>
                                        </p>
                                    </div>
                                    <% if(currUser && currUser._id.toString()===review.auther._id.toString()) { %>
                                        <form action="/listings/<%= item.id %>/reviews/<%= review.id %>?_method=delete"
                                            method="post">
                                            <button class="btn btn-dark btn-sm mb-3">Delete</button>
                                        </form>
                                        <% } %>
                                </div>

                                <% } %>
                        </div>

            </div>

        </div>

    </body>