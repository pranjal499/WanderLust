<% layout('/layouts/boilarplate.ejs') %>

    <!-- Body -->
    <body>

        <!-- Listing card -->
        <div class="row listing-form">
            <div class="col-6 offset-3">

                <div class="card" style="width: 30rem;">
                    <h3><%= item.title%></h3>
                    <img src="<%= item.image.url %>" class="card-img-top" alt="<%= item.title%>">

                    <div class="card-body">
                        <ul>
                            <b><%= item.title%></b>
                            <li>
                                <%= item.description%>
                            </li>
                            <li>&#8377;<%= item.price.toLocaleString("en-in")%>
                            </li>
                            <li>
                                <%= item.location%>
                            </li>
                        </ul>
                        <br>

                        <!-- Buttons -->
                        <div class="show-btns">
                            <a href="/listings/<%= item._id%>/edit" class="btn btn-dark btn-add">Edit</a>
                            <form action="/listings/<%= item._id%>?_method=delete" method="post">
                                <button class="btn btn-dark">Delete</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review -->
            <div class="col-6 offset-3">
                <hr>
                <h4>Leave a review</h4>
                <form action="/listings/<%= item._id%>/reviews" method="post">
                    <div class="mb-3 mt-3">
                        <label for="rating" class="form-lable">Rating</label>
                        <input type="range" name="review[rating]" id="rating" min="1" max="5" class="form-range">
                    <div class="mb-3 mt-3">
                        <label for="comment" class="form-lable">Comment</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control"></textarea>
                    </div>
                    <button class="btn btn-outline-dark">Submit</button>
                </form>
            </div>



        </div>

    </body>